<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Minhas Tarefas - TASKMZ</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
}

.header {
    background: linear-gradient(135deg, #087f23, #16a34a);
    color: white;
    padding: 22px 18px;
    border-radius: 0 0 25px 25px;
}

.top {
    display: flex;
    align-items: center;
    gap: 15px;
    max-width: 700px;
    margin: auto;
}

.back {
    color: white;
    text-decoration: none;
    font-size: 28px;
}

.title {
    font-size: 22px;
    font-weight: bold;
}

.subtitle {
    font-size: 14px;
    margin-top: 5px;
    opacity: 0.9;
}

.container {
    max-width: 700px;
    margin: auto;
    padding: 18px;
}

.task {
    background: white;
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.07);
}

.task-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
}

.task-title {
    font-size: 18px;
    font-weight: bold;
}

.value {
    background: #e7f8ec;
    color: #087f23;
    padding: 8px 12px;
    border-radius: 20px;
    font-weight: bold;
    white-space: nowrap;
}

.description {
    margin: 15px 0;
    color: #667085;
    font-size: 14px;
    line-height: 1.6;
    white-space: pre-line;
}

.status {
    display: inline-block;
    padding: 9px 13px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 12px;
}

.pendente {
    background: #fff3cd;
    color: #856404;
}

.aguardando {
    background: #fff3cd;
    color: #856404;
}

.aprovada {
    background: #d4edda;
    color: #155724;
}

.rejeitada {
    background: #f8d7da;
    color: #721c24;
}

.action {
    display: block;
    text-decoration: none;
    background: #087f23;
    color: white;
    text-align: center;
    padding: 14px;
    border-radius: 12px;
    font-weight: bold;
    margin-top: 8px;
}

.action:active {
    transform: scale(0.98);
}

.empty {
    background: white;
    padding: 40px 20px;
    text-align: center;
    border-radius: 20px;
    box-shadow: 0 5px 18px rgba(0,0,0,0.06);
    color: #667085;
}

.empty-icon {
    font-size: 50px;
    margin-bottom: 12px;
}

.footer {
    text-align: center;
    color: #98a2b3;
    font-size: 12px;
    padding: 25px 10px;
}

</style>
</head>

<body>

<div class="header">

    <div class="top">

        <a href="/dashboard" class="back">←</a>

        <div>
            <div class="title">✅ Minhas Tarefas</div>

            <div class="subtitle">
                Acompanhe as tarefas que aceitou
            </div>
        </div>

    </div>

</div>


<div class="container">

<% if (!tasks || tasks.length === 0) { %>

    <div class="empty">

        <div class="empty-icon">📭</div>

        <strong>Ainda não aceitou nenhuma tarefa</strong>

        <p>Veja as tarefas disponíveis e comece a ganhar dinheiro.</p>

        <a href="/tasks" class="action">
            📋 Ver Tarefas Disponíveis
        </a>

    </div>

<% } else { %>

    <% tasks.forEach(task => { %>

        <% 
        const participante = (task.participantes || []).find(
            p => p.userId === user.id
        );
        %>

        <% if (participante) { %>

        <div class="task">

            <div class="task-top">

                <div class="task-title">
                    <%= task.titulo %>
                </div>

                <div class="value">
                    💰 <%= Number(task.valor || 0).toFixed(2) %> MT
                </div>

            </div>


            <div class="description">
                <%= task.descricao %>
            </div>


            <% if (participante.status === "pendente" || participante.status === "aceita") { %>

                <div class="status pendente">
                    ⏳ Tarefa aceita — envie a prova
                </div>

                <a href="/tasks/<%= task.id %>/proof" class="action">
                    📤 Enviar Prova
                </a>


            <% } else if (participante.status === "aguardando") { %>

                <div class="status aguardando">
                    ⏳ Prova enviada — aguardando análise
                </div>


            <% } else if (participante.status === "aprovada") { %>

                <div class="status aprovada">
                    ✅ Tarefa aprovada — pagamento adicionado ao saldo
                </div>


            <% } else if (participante.status === "rejeitada") { %>

                <div class="status rejeitada">
                    ❌ Prova rejeitada — envie uma nova prova
                </div>

                <a href="/tasks/<%= task.id %>/proof" class="action">
                    🔄 Enviar Nova Prova
                </a>


            <% } else { %>

                <div class="status pendente">
                    📌 Estado: <%= participante.status %>
                </div>

            <% } %>

        </div>

        <% } %>

    <% }) %>

<% } %>

</div>


<div class="footer">
    🇲🇿 TASKMZ • Plataforma de Microtarefas
</div>

</body>
</html>
