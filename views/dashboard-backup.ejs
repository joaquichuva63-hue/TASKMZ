<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - TASKMZ</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7f5;
            color: #1f2937;
        }

        .header {
            background: linear-gradient(135deg, #047857, #16a34a);
            color: white;
            padding: 22px 18px 75px;
            border-radius: 0 0 30px 30px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .online {
            background: rgba(255,255,255,0.18);
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

        .welcome {
            margin-top: 25px;
            font-size: 14px;
            opacity: 0.9;
        }

        .user-name {
            font-size: 20px;
            font-weight: bold;
            margin-top: 5px;
        }

        .container {
            max-width: 700px;
            margin: auto;
            padding: 0 16px 25px;
        }

        .balance {
            background: white;
            border-radius: 22px;
            padding: 22px;
            margin-top: -50px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.10);
        }

        .balance-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .balance small {
            color: #6b7280;
            font-size: 14px;
        }

        .balance-icon {
            font-size: 28px;
            background: #dcfce7;
            padding: 10px;
            border-radius: 15px;
        }

        .money {
            font-size: 34px;
            font-weight: bold;
            color: #087f23;
            margin-top: 12px;
        }

        .balance-info {
            margin-top: 8px;
            color: #9ca3af;
            font-size: 12px;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 16px;
        }

        .quick-button {
            background: #087f23;
            color: white;
            padding: 13px;
            border-radius: 14px;
            text-align: center;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
        }

        .quick-button.secondary {
            background: #f0fdf4;
            color: #087f23;
            border: 1px solid #bbf7d0;
        }

        .section-title {
            margin: 28px 0 14px;
            font-size: 18px;
            font-weight: bold;
        }

        .section-subtitle {
            color: #6b7280;
            font-size: 13px;
            margin-top: -8px;
            margin-bottom: 15px;
        }

        .menu {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 13px;
        }

        .card {
            background: white;
            padding: 18px 12px;
            border-radius: 20px;
            text-decoration: none;
            color: #222;
            box-shadow: 0 5px 18px rgba(0,0,0,0.06);
            transition: 0.2s;
        }

        .card:active {
            transform: scale(0.97);
        }

        .icon-box {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f0fdf4;
            border-radius: 15px;
            font-size: 25px;
            margin-bottom: 12px;
        }

        .card-title {
            font-size: 14px;
            font-weight: bold;
            line-height: 1.3;
        }

        .card-text {
            font-size: 11px;
            color: #9ca3af;
            margin-top: 5px;
        }

        .support {
            display: block;
            margin-top: 25px;
            background: linear-gradient(135deg, #087f23, #16a34a);
            color: white;
            text-decoration: none;
            padding: 17px;
            border-radius: 18px;
            text-align: center;
            font-weight: bold;
            box-shadow: 0 8px 20px rgba(8,127,35,0.20);
        }

        .logout {
            display: block;
            margin-top: 14px;
            background: white;
            color: #dc2626;
            text-decoration: none;
            padding: 15px;
            border-radius: 16px;
            text-align: center;
            font-weight: bold;
            border: 1px solid #fee2e2;
        }

        .footer {
            text-align: center;
            color: #9ca3af;
            font-size: 12px;
            padding: 28px 10px 10px;
        }

        @media (max-width: 350px) {
            .menu {
                grid-template-columns: 1fr;
            }

            .quick-actions {
                grid-template-columns: 1fr;
            }

            .money {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

    <div class="header">

        <div class="top-bar">
            <div class="logo">🇲🇿 TASKMZ</div>

            <div class="online">
                🟢 Online
            </div>
        </div>

        <div class="welcome">
            👋 Bem-vindo de volta!
        </div>

        <div class="user-name">
            Utilizador TASKMZ
        </div>

    </div>


    <div class="container">

        <div class="balance">

            <div class="balance-top">

                <div>
                    <small>💰 Saldo disponível</small>

                    <div class="money">
                        <%= Number(user.saldo || 0).toFixed(2) %> MT
                    </div>

                    <div class="balance-info">
                        O seu dinheiro disponível na TASKMZ
                    </div>
                </div>

                <div class="balance-icon">
                    💰
                </div>

            </div>

        </div>


        <div class="quick-actions">

            <a href="/tasks" class="quick-button">
                📋 Ver tarefas
            </a>

            <a href="/withdraw" class="quick-button secondary">
                💸 Levantar
            </a>

        </div>


        <div class="section-title">
            📱 Serviços
        </div>

        <div class="section-subtitle">
            Escolha uma opção para continuar
        </div>


        <div class="menu">

            <a href="/tasks" class="card">

                <div class="icon-box">📋</div>

                <div class="card-title">
                    Tarefas disponíveis
                </div>

                <div class="card-text">
                    Ganhe dinheiro realizando tarefas
                </div>

            </a>


            <a href="/my-tasks" class="card">

                <div class="icon-box">✅</div>

                <div class="card-title">
                    Minhas tarefas
                </div>

                <div class="card-text">
                    Acompanhe as suas tarefas
                </div>

            </a>


            <a href="/notifications" class="card">

                <div class="icon-box">🔔</div>

                <div class="card-title">
                    Notificações
                </div>

                <div class="card-text">
                    Veja as últimas atualizações
                </div>

            </a>


            <a href="/withdraw" class="card">

                <div class="icon-box">💸</div>

                <div class="card-title">
                    Levantar dinheiro
                </div>

                <div class="card-text">
                    Peça o levantamento do saldo
                </div>

            </a>


<a href="/withdraw/history" class="card">
                <div class="icon-box">📜</div>

                <div class="card-title">
                    Histórico
                </div>

                <div class="card-text">
                    Veja os seus levantamentos
                </div>

            </a>


            <a href="/payment-method" class="card">

                <div class="icon-box">💳</div>

                <div class="card-title">
                    Pagamento
                </div>

                <div class="card-text">
                    Configure a forma de receber
                </div>

            </a>

        </div>


        <a href="mailto:mztask42@gmail.com?subject=Suporte%20TASKMZ"
           class="support">
            📩 Precisa de ajuda? Contactar Suporte
        </a>


        <a href="/logout" class="logout">
            🚪 Terminar sessão
        </a>


        <div class="footer">
            🇲🇿 <strong>TASKMZ</strong><br>
            Plataforma de Microtarefas
        </div>

    </div>

</body>
</html>
