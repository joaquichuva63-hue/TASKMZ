<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Minhas Tarefas - TASKMZ</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f3f5f9;
            color: #222;
        }

        .header {
            background: linear-gradient(135deg, #087f23, #16a34a);
            color: white;
            padding: 20px;
            border-radius: 0 0 25px 25px;
        }

        .top {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .back {
            color: white;
            text-decoration: none;
            font-size: 28px;
        }

        .title {
            font-size: 22px;
            font-weight: bold;
        }

        .subtitle {
            font-size: 14px;
            margin-top: 5px;
            opacity: 0.9;
        }

        .container {
            max-width: 700px;
            margin: auto;
            padding: 18px;
        }

        .task {
            background: white;
            border-radius: 18px;
            padding: 18px;
            margin-bottom: 15px;
            box-shadow: 0 5px 18px rgba(0,0,0,0.07);
        }

        .task-top {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: flex-start;
        }

        .task-title {
            font-size: 18px;
            font-weight: bold;
        }

        .value {
            background: #e7f8ec;
            color: #087f23;
            padding: 7px 10px;
            border-radius: 20px;
            font-weight: bold;
            white-space: nowrap;
        }

        .description {
            margin: 14px 0;
            color: #666;
            font-size: 14px;
            line-height: 1.5;
            white-space: pre-line;
        }

        .status {
            display: inline-block;
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .pendente {
            background: #fff3cd;
            color: #856404;
        }

        .aprovada {
            background: #d4edda;
            color: #155724;
        }

        .rejeitada {
            background: #f8d7da;
            color: #721c24;
        }

        .concluida {
            background: #d1ecf1;
            color: #0c5460;
        }

        .action {
            display: block;
            text-decoration: none;
            background: #087f23;
            color: white;
            text-align: center;
            padding: 13px;
            border-radius: 12px;
            font-weight: bold;
            margin-top: 8px;
        }

        .empty {
            background: white;
            padding: 35px 20px;
            text-align: center;
            border-radius: 18px;
            box-shadow: 0 5px 18px rgba(0,0,0,0.06);
            color: #666;
        }

        .empty-icon {
            font-size: 50px;
            margin-bottom: 12px;
        }

        .footer {
            text-align: center;
            color: #888;
            font-size: 12px;
            padding: 20px;
        }
    </style>
</head>

<body>

<div class="header">

    <div class="top">

        <a href="/dashboard" class="back">←</a>

        <div>
            <div class="title">✅ Minhas Tarefas</div>

            <div class="subtitle">
                Acompanhe o estado das suas tarefas
            </div>
        </div>

    </div>

</div>

<div class="container">

    <% if (!tasks || tasks.length === 0) { %>

        <div class="empty">

            <div class="empty-icon">📭</div>

            <strong>Ainda não aceitou nenhuma tarefa</strong>

            <p>Veja as tarefas disponíveis e comece a ganhar.</p>

            <a href="/tasks" class="action">
                📋 Ver Tarefas Disponíveis
            </a>

        </div>

    <% } else { %>

        <% tasks.forEach(item => { %>

            <div class="task">

                <div class="task-top">

                    <div class="task-title">
                        <%= item.task.titulo %>
                    </div>

                    <div class="value">
                        💰 <%= Number(item.task.valor || 0).toFixed(2) %> MT
                    </div>

                </div>

                <div class="description">
                    <%= item.task.descricao %>
                </div>

                <% if (item.participante.status === "pendente") { %>

                    <div class="status pendente">
                        ⏳ Aguardando envio da prova
                    </div>

                    <a href="/send-proof/<%= item.task.id %>" class="action">
                        📤 Enviar Prova
                    </a>

                <% } else if (item.participante.status === "aprovada") { %>

                    <div class="status aprovada">
                        ✅ Tarefa aprovada
                    </div>

                <% } else if (item.participante.status === "rejeitada") { %>

                    <div class="status rejeitada">
                        ❌ Prova rejeitada
                    </div>

                    <a href="/send-proof/<%= item.task.id %>" class="action">
                        🔄 Enviar nova prova
                    </a>

                <% } else { %>

                    <div class="status concluida">
                        📌 <%= item.participante.status %>
                    </div>

                <% } %>

            </div>

        <% }) %>

    <% } %>

</div>

<div class="footer">
    🇲🇿 TASKMZ • Plataforma de Microtarefas
</div>

</body>
</html>
