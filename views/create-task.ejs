<!DOCTYPE html>
<html lang="pt">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Criar Tarefa - TASKMZ</title>

<style>

* {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    margin: 0;
    background: #f3f4f3;
}

header {
    background: #111;
    color: white;
    padding: 22px;
    text-align: center;
}

.container {
    max-width: 600px;
    margin: 25px auto;
    padding: 20px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.1);
}

h2 {
    text-align: center;
}

label {
    display: block;
    margin-top: 18px;
    font-weight: bold;
}

input, textarea {
    width: 100%;
    padding: 14px;
    margin-top: 7px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
}

textarea {
    min-height: 130px;
}

button {
    width: 100%;
    padding: 16px;
    margin-top: 25px;
    background: #087f23;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 17px;
    font-weight: bold;
}

.success {
    background: #d9f7df;
    color: #087f23;
    padding: 13px;
    border-radius: 8px;
    text-align: center;
    margin-bottom: 15px;
}

.error {
    background: #ffe0e0;
    color: #b00000;
    padding: 13px;
    border-radius: 8px;
    text-align: center;
    margin-bottom: 15px;
}

.back {
    display: block;
    text-align: center;
    margin-top: 20px;
    color: #087f23;
    text-decoration: none;
    font-weight: bold;
}

</style>

</head>

<body>

<header>

<h2>➕ Criar Tarefa</h2>

<p>Administrador TASKMZ</p>

</header>


<div class="container">

<div class="card">

<h2>Nova tarefa</h2>


<% if (error) { %>

<div class="error">
<%= error %>
</div>

<% } %>


<% if (success) { %>

<div class="success">
<%= success %>
</div>

<% } %>


<form action="/admin/create-task" method="POST">

<label>📝 Título da tarefa</label>

<input
type="text"
name="titulo"
placeholder="Ex: Seguir página no Facebook"
required
>


<label>📄 Instruções da tarefa</label>

<textarea
name="descricao"
placeholder="Explique exatamente o que o utilizador deve fazer..."
required
></textarea>


<label>💰 Valor por pessoa (MT)</label>

<input
type="number"
name="valor"
placeholder="Ex: 5"
min="1"
step="0.50"
required
>


<label>👥 Número de vagas</label>

<input
type="number"
name="vagas"
placeholder="Ex: 100"
min="1"
required
>


<button type="submit">
🚀 PUBLICAR TAREFA
</button>

</form>


<a href="/admin/dashboard" class="back">
← Voltar ao painel Admin
</a>

</div>

</div>

</body>
</html>
